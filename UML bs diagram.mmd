   classDiagram
    class UserProgram {
        +string Name
        +List~ICommand~ Commands
        +Character Character
        +Execute(): void
        +CalculateMetrics(): ProgramMetrics
    }

    class CommandFactory {
        <<static>>
        -Move: string
        -Turn: string
        -Repeat: string
        -Right: string
        -Left: string
        -Times: string

        -ParseMove(string[] parts) MoveCommand
        -ParseTurn(string[] parts) TurnCommand
        -ParseCommand(lines:Queue~ParsedLine~, currentIndent:int): ICommand
        
        +FromLines(lines: IReadOnlyList~ParsedLine~) List~ICommand~
        +CreateMove(steps: uint) MoveCommand
        +CreateTurn(direction: Direction.LeftRight) TurnCommand
        +CreateRepeat(amount: uint, subCommands: IReadOnlyList~ICommand~) RepeatCommand
    }

    class ICommand {
        <<interface>> 
        +Execute(c: Character): void
    }

    class MoveCommand{
        +uint Steps
        +Execute(Character c): void
    }

    class TurnCommand{
        +Direction.LeftRight direction
        +Execute(Character c): void
    }

    class RepeatCommand{
        +uint Amount
        +IReadOnlyList~ICommand~ subCommands
        +Execute(Character c): void
    }

    class Direction {
        <<enumeration>> Heading
        EAST
        WEST 
        NORTH 
        SOUTH
        <<enum>> LeftRight
        Left 
        Right
        + Right: Dictionary ~Heading, Heading~
        + Left: Dictionary ~Heading, Heading~
        + Step: Dictionary ~Heading, (int, int)~
    }

    class Character {
        +int X
        +int Y
        +Direction.Heading Facing
        -List ~string~ executeCommandTrace
        +ResetToStart(): void
        +MoveForwards(int steps): void
        +Turn(Direction.LeftRight direction): void
        GetState(): string
        GetTraceEntries(): IReadOnlyList~string~
    }

    class ProgramImporter {
        +ImportFromFile(string filePath) UserProgram
    }

    class LineParser {
        +ParseBlock(string[] lines) List~ParsedLine~
        -GetIndent(string line) int
    }

    class ParsedLine {
        +int Indent
        +string Command
        +string[] Parts
    }

    class ProgramMetrics {
        +int CommandCount
        +int MaxNestingLevel
        +int RepeatCount
        +Analyze(UserProgram program): void
        +Calculate(Program program) ProgramMetrics
    }


    
    ProgramImporter ..> CommandFactory
    CommandFactory ..> ICommand
    CommandFactory <.. ParsedLine
    UserProgram "1" *-- "0..*" ICommand 
    UserProgram "1" *-- "1" Character
    ICommand <|.. MoveCommand
    ICommand <|.. TurnCommand
    ICommand <|.. RepeatCommand
    RepeatCommand "1" *-- "0..*" ICommand
    ProgramImporter ..> LineParser 
    ProgramImporter ..> UserProgram 
    LineParser ..> ParsedLine 
    ProgramMetrics --> UserProgram 
