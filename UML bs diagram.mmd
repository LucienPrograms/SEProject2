   classDiagram
    class Form1 {
        -ProgramService programService
        -TextBox programEditor
        -TextBox outputBox
        -TextBox metricsBox
        +Form1()
        -BuildInterface(): void
        -LoadFile(): void
        -LoadBasic(): void
        -LoadAdvanced(): void
        -LoadExpert(): void
        -RunProgram(): void
        -ShowMetrics(): void
    }

    class ProgramService {
        -UserProgram currentProgram
        +LoadProgram(filePath: string): void
        +LoadProgramFromText(name: string, text: string): void
        +RunProgram(): ExecutionResult
        +GetMetrics(): ProgramMetrics
    }

    class ExecutionResult{
        +string Trace
        +string FinalState
    }

    class LunarProgram {
        +string Name
        +List~ICommand~ Commands
        +Character Character
        +Execute(): void
        +CalculateMetrics(): ProgramMetrics
    }

    class CommandFactory {
        <<static>>
        -Move: string
        -Turn: string
        -Repeat: string
        -Right: string
        -Left: string
        -Times: string

        -ParseMove(string[] parts) MoveCommand
        -ParseTurn(string[] parts) TurnCommand
        -ParseCommand(lines:Queue~ParsedLine~, currentIndent:int): ICommand
        
        +FromLines(lines: IReadOnlyList~ParsedLine~) List~ICommand~
        +CreateMove(steps: uint) MoveCommand
        +CreateTurn(direction: Direction.LeftRight) TurnCommand
        +CreateRepeat(amount: uint, subCommands: IReadOnlyList~ICommand~) RepeatCommand
        +CreateRepeatUntil(RepeatCondition condition, IReadOnlyList<ICommand> subCommands) RepeatUntilCommand
    }

    class ICommand {
        <<interface>> 
        +Execute(c: Character): void
    }

    class MoveCommand{
        +uint Steps
        +Execute(Character c): void
    }

    class TurnCommand{
        +Direction.LeftRight direction
        +Execute(Character c): void
    }

    class RepeatCommand{
        +uint Amount
        +IReadOnlyList~ICommand~ subCommands
        +Execute(Character c): void
    }

    class RepeatUntilCommand {
        <<enumeration>> RepeatCondition
        WallAhead
        GridEdge
        +enum condition
        +IReadOnlyList~ICommand~ subCommands
        +Execute(Character c): void
    }

    class Direction {
        <<enumeration>> Heading
        EAST
        WEST 
        NORTH 
        SOUTH
        <<enumeration>> LeftRight
        Left 
        Right
        + Right: Dictionary ~Heading, Heading~
        + Left: Dictionary ~Heading, Heading~
        + Step: Dictionary ~Heading, (int, int)~
    }

    class Luna {
        +int X
        +int Y
        +Direction.Heading Facing
        +public Space AsteroidField
        -List ~string~ executeCommandTrace
        +ResetToStart(): void
        +GoalReached(): bool
        +IsWallAhead(): bool
        +IsGridEdge(): bool
        +MoveForwards(int steps): void
        +Turn(Direction.LeftRight direction): void
        GetState(): string
        GetTraceEntries(): IReadOnlyList~string~
    }

    class Space {
        +int Height
        +int Width
        +List<List<States>> AsteroidField
        <<enumeration>> States
        Asteroid
        Empty
        Goal
        -ParseGrid(string[] lines): void
        -ConvertToState(char character): States
        -CheckLineLength(string[] lines): bool
        +Collision(int x, int y): bool
        +IsDestination(int x, int y): bool
    }


    class ProgramImporter {
        +ImportFromFile(string filePath) UserProgram
    }

    class LineParser {
        +ParseBlock(string[] lines) List~ParsedLine~
        -GetIndent(string line) int
    }

    class ParsedLine {
        +int Indent
        +string Command
        +string[] Parts
    }

    class ProgramMetrics {
        +int CommandCount
        +int MaxNestingLevel
        +int RepeatCount
        +Analyze(UserProgram program): void
        +Calculate(Program program) ProgramMetrics
    }

